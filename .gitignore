.DS_Store
Thumbs.db

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Ephemeral clone-per-run workspaces, when running outside a container
workspaces/

# Real secret files - only the .example templates are tracked
secrets/*.txt

# A copy of the claude CLI's session, if an operator points CLAUDE_SESSION_DIR at a path
# inside the repo (ADR-0022 recommends one outside it). `.credentials.json` is not a .txt,
# so the rule above would not have caught it.
secrets/claude-session/

# Cross-repo planning docs live outside this repo's tree, so they can't normally
# end up here — this is a defensive backstop in case one is ever copied in by
# mistake. Never commit these.
4-repo-migration-PLAN.md
4-repo-migration-PROMPT.md

# Created by the mermaid diagram check, which npm-installs into the repo.
# CI does this on every run; nothing here is ever a build input.
node_modules/
package-lock.json
