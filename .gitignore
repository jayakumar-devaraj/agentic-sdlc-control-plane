.DS_Store
Thumbs.db

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Ephemeral clone-per-run workspaces, when running outside a container
workspaces/

# Real secret files - only the .example templates are tracked
secrets/*.txt

# A copy of the claude CLI's session, if an operator points CLAUDE_SESSION_DIR at a path
# inside the repo (ADR-0022 recommends one outside it). `.credentials.json` is not a .txt,
# so the rule above would not have caught it.
secrets/claude-session/

# Cross-repo planning docs live outside this repo's tree, so they can't normally
# end up here — this is a defensive backstop in case one is ever copied in by
# mistake. Never commit these.
4-repo-migration-PLAN.md
4-repo-migration-PROMPT.md

# Created by the mermaid diagram check, which npm-installs into the repo.
# CI does this on every run; nothing here is ever a build input.
node_modules/
package-lock.json

# ---------------------------------------------------------------------------
# LangGraph Dev / LangGraph Studio - LOCAL ONLY, NEVER COMMITTED.
#
# Everything the local dev server needs lives in one directory, so one rule
# covers the config, the Studio entrypoint module, the .env, and the per-thread
# workspaces runs write. .langgraph-dev/.gitignore repeats the exclusion from
# the inside as a backstop.
.langgraph-dev/

# The dev server's own local state: it pickles threads/runs/assistants into
# .langgraph_api/ beside wherever it was started, so ignore it at any depth in
# case the server is launched from the repo root rather than from .langgraph-dev/.
.langgraph_api/
**/.langgraph_api/

# A langgraph.json accidentally created at the repo root (e.g. by `langgraph new`
# or by copying the config out of .langgraph-dev/). This repository ships no
# LangGraph Platform config; the only one that exists is the ignored local copy.
/langgraph.json
.langgraph-dev.env
