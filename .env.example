# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# EVERY VARIABLE HERE IS READ ONLY BY `docker-compose.specialist.yml`.
# The default stack needs none of them:
#
#     docker compose up -d                      <- nothing below applies
#     docker compose -f docker-compose.yml \
#                    -f docker-compose.specialist.yml up -d   <- these apply
#
# A specialist-capable deployment needs four things that cannot live in a committed
# file (ADR-0022). Three are below; the fourth is a write-scoped PAT in
# `secrets/github_pat.txt`, which is a secret file rather than a variable.


# --- required by the specialist override -------------------------------------------
#
# A directory holding a copy of the `claude` CLI's `.credentials.json`, and nothing
# else. The image carries the CLI and cannot carry a login: a session is per-operator,
# and baking one into an image publishes a credential.
#
# There is deliberately no default. The container mounts this READ-WRITE, because the
# CLI writes state as it runs, and it also runs a specialist that executes generated
# code. Pointing this at your live `~/.claude` hands that directory to whatever the run
# produces. Use a copy.
#
# Compose fails with a named error if this is unset, rather than starting without it.
CLAUDE_SESSION_DIR=/path/to/a/copy/of/your/claude/session


# --- optional: tracing for the specialist subprocess --------------------------------
#
# Unset means off. The specialist constructs no exporter unless an endpoint is named,
# so a deployment that wants no telemetry sets neither of these and pays nothing.
#
# These are OpenTelemetry's own standard variable names, not this platform's - no file
# in either repository names a tracing backend, so changing where spans go is a
# variable rather than a code change.
#
# FROM INSIDE THE CONTAINER, `localhost` IS THE CONTAINER. A collector running on your
# own machine is reached at `host.docker.internal`, not at the `localhost` URL your
# browser shows. A `localhost` copied out of the address bar produces a connection
# refused that looks like a broken collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# CARRIES A CREDENTIAL. This is the reason `.env` is gitignored.
OTEL_EXPORTER_OTLP_HEADERS=
